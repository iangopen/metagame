{
  // The engine: pure TypeScript. lib has no DOM and types is empty (no @types/node), so any use of
  // document, window, HTMLElement and friends in src/engine fails `npm run build`. Tests are checked
  // separately (tsconfig.engine-test.json) because they import vitest and node:fs.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/engine"],
  "exclude": ["src/engine/**/*.test.ts"]
}
